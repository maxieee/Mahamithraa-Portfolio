# Copy to `.env.local` and fill in. Every value below is optional — the site
# builds and runs with none of them set.

# Canonical origin. Used for metadataBase, OpenGraph URLs, sitemap and robots.
# Without it those fall back to a placeholder domain, which is fine locally but
# should be set before you deploy.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Address shown on the contact panel and used as the mailto fallback.
NEXT_PUBLIC_CONTACT_EMAIL=you@your-domain.com

# --- Contact form delivery -------------------------------------------------
# The form validates and rate-limits with or without these. With them set it
# delivers over Resend; without them the API responds `delivered: false` and the
# UI falls back to a prefilled mailto link, so the form is never a dead end.
#
# RESEND_API_KEY and CONTACT_FROM_EMAIL must BOTH be set for delivery to happen.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
CONTACT_FROM_EMAIL=portfolio@your-domain.com
# Where enquiries land. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO_EMAIL=you@your-domain.com
